pipeline {
    agent any

    stages {
        stage('Git checkout') {
            steps {
                script {
                    git credentialsId: 'github-login', // Attention à adapter !!!!
                        url: 'git@github.com:guigui-er/FinalProjectV2.git',
                        branch: 'main'
                }
            }
        }

        stage('Maven Package') {
            agent {
                docker {
                    image 'maven:3.10.0-eclipse-temurin-21'
                    // args '''
                    //     -v $HOME/.m2:/root/.m2:z
                    //     -u root
                    //     --network devops
                    // '''
                    // A ADAPTER 
                    reuseNode true // Permet de partager l'espace de travail entre l'agent Jenkins et l'agent Docker
                }
            }

            steps {
                //dir('BOOT-SECURITY/quest-boot') {
                    withSonarQubeEnv('sonar') {
                        sh 'mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=quest-boot'
                    }
                }
            //} // A voir si ça fonctionne !!
        }

        stage('Docker Compose') {
            steps {
                dir('../') { // A voir si ça fonctionne !!! (../FinalProject) ? 
                    sh 'docker compose up -d --build java db pma'
                }
            }
        }
    }
}